{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KRONOS",
  "version": "0.1.3",
  "identifier": "online.kronosterminal.desktop",
  "build": {},
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "KRONOS",
        "url": "https://kronosterminal.online/terminal",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#05080F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "KRONOS",
    "category": "Finance",
    "shortDescription": "KRONOS Terminal",
    "longDescription": "Live trading intelligence, signals, and AI desk. This app is a window on kronosterminal.online; nothing runs locally and nothing is cached.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "startMenuFolder": "KRONOS",
        "template": "installer/installer.nsi"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    }
  }
}
